<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_preview_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/widget_preview_ring_calories"
            android:gravity="center"
            android:text="1,140"
            android:textColor="@color/fuel_calories"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="kcal"
            android:textColor="@color/fuel_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/widget_preview_ring_protein"
            android:gravity="center"
            android:text="71"
            android:textColor="@color/fuel_protein"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="protein"
            android:textColor="@color/fuel_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/widget_preview_ring_fiber"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/fuel_lime"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="fiber"
            android:textColor="@color/fuel_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_preview_add_button"
        android:gravity="center"
        android:text="+"
        android:textColor="@color/fuel_background"
        android:textSize="24sp"
        android:textStyle="bold" />
</LinearLayout>
