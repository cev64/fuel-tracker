<?xml version="1.0" encoding="utf-8"?>
<!-- Everything Fuel stores is the user's own log, so all of it is backed up. -->
<full-backup-content>
    <include domain="database" path="fuel.db" />
    <include domain="database" path="fuel.db-shm" />
    <include domain="database" path="fuel.db-wal" />
    <include domain="file" path="datastore/" />
</full-backup-content>
