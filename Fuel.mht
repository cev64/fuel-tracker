@charset "utf-8";

:root { --bg: #0f0f0f; --surface: #1a1a1a; --surface2: #242424; --surface3: #2e2e2e; --border: rgba(255,255,255,0.08); --border2: rgba(255,255,255,0.14); --text: #f0f0f0; --text2: #888; --text3: #555; --accent: #c8f060; --accent2: #a8d440; --accent-dim: rgba(200,240,96,0.12); --red: #ff5c5c; --blue: #5cb8ff; --orange: #ffaa5c; --radius: 16px; --radius-sm: 10px; --safe-top: env(safe-area-inset-top, 0px); --safe-bottom: env(safe-area-inset-bottom, 0px); }

* { box-sizing: border-box; margin: 0px; padding: 0px; -webkit-tap-highlight-color: transparent; }

html, body { height: 100%; background: var(--bg); color: var(--text); font-family: "DM Sans", sans-serif; font-size: 15px; line-height: 1.5; overscroll-behavior: none; }

#app { max-width: 480px; margin: 0px auto; min-height: 100dvh; display: flex; flex-direction: column; position: relative; }

.app-header { padding: calc(var(--safe-top) + 20px) 20px 0; flex-shrink: 0; }

.wordmark { font-family: Syne, sans-serif; font-size: 28px; font-weight: 800; letter-spacing: -0.03em; color: var(--text); display: flex; align-items: center; gap: 6px; }

.wordmark span { color: var(--accent); }

.tab-bar { display: flex; gap: 4px; padding: 16px 20px 0px; flex-shrink: 0; }

.tab-btn { flex: 1 1 0%; padding: 9px 6px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); font-family: "DM Sans", sans-serif; font-size: 13px; font-weight: 500; color: var(--text2); cursor: pointer; transition: 0.2s; letter-spacing: 0.01em; }

.tab-btn.active { background: var(--accent); color: rgb(15, 15, 15); border-color: var(--accent); font-weight: 600; }

.tab-content { flex: 1 1 0%; overflow-y: auto; padding: 16px 20px calc(var(--safe-bottom) + 20px); display: none; }

.tab-content.active { display: block; }

.form-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; margin-bottom: 12px; }

.form-card h2 { font-family: Syne, sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text2); margin-bottom: 16px; }

.input-group { margin-bottom: 12px; }

.input-group label { display: block; font-size: 11px; font-weight: 500; color: var(--text3); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 6px; }

.input-group input { width: 100%; background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px 14px; font-family: "DM Sans", sans-serif; font-size: 16px; color: var(--text); outline: none; transition: border-color 0.2s; appearance: none; }

.input-group input::placeholder { color: var(--text3); }

.input-group input:focus { border-color: var(--accent); background: var(--surface3); }

.macros-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 16px; }

.macro-input label { font-size: 11px; }

.macro-input input { width: 100%; background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px 10px; font-family: "DM Sans", sans-serif; font-size: 16px; color: var(--text); outline: none; text-align: center; transition: border-color 0.2s; appearance: none; }

.macro-input input::placeholder { color: var(--text3); font-size: 14px; }

.macro-input input:focus { border-color: var(--accent); background: var(--surface3); }

.macro-input .macro-label { font-size: 10px; font-weight: 500; color: var(--text3); letter-spacing: 0.06em; text-transform: uppercase; display: block; text-align: center; margin-bottom: 6px; }

.btn-submit { width: 100%; padding: 14px; background: var(--accent); color: rgb(15, 15, 15); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: var(--radius-sm); font-family: Syne, sans-serif; font-size: 15px; font-weight: 700; letter-spacing: 0.02em; cursor: pointer; transition: 0.15s; appearance: none; }

.btn-submit:active { transform: scale(0.98); background: var(--accent2); }

.day-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }

.day-nav-btn { width: 38px; height: 38px; background: var(--surface); border: 1px solid var(--border); border-radius: 50%; font-size: 18px; color: var(--text2); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.15s; }

.day-nav-btn:active { background: var(--surface3); }

.day-label-wrap { text-align: center; }

.day-label-main { font-family: Syne, sans-serif; font-size: 18px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }

.day-label-sub { font-size: 12px; color: var(--text2); margin-top: 1px; }

.totals-strip { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 16px; }

.total-tile { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 10px; text-align: center; }

.total-tile.cals { border-color: rgba(255, 90, 90, 0.25); }

.total-tile.prot { border-color: rgba(92, 184, 255, 0.25); }

.total-tile.fib { border-color: rgba(200, 240, 96, 0.25); }

.tile-val { font-family: Syne, sans-serif; font-size: 26px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; }

.total-tile.cals .tile-val { color: var(--red); }

.total-tile.prot .tile-val { color: var(--blue); }

.total-tile.fib .tile-val { color: var(--accent); }

.tile-label { font-size: 11px; color: var(--text2); margin-top: 4px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; }

.food-log-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; }

.food-log-title { padding: 14px 16px; font-family: Syne, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text2); border-bottom: 1px solid var(--border); }

.food-item { display: flex; align-items: center; padding: 13px 16px; border-bottom: 1px solid var(--border); gap: 12px; animation: 0.2s ease 0s 1 normal none running slideIn; }

@keyframes slideIn { 
  0% { opacity: 0; transform: translateY(-6px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.food-item:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.food-info { flex: 1 1 0%; min-width: 0px; }

.food-name { font-weight: 500; font-size: 15px; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.food-macros { font-size: 12px; color: var(--text2); margin-top: 2px; display: flex; gap: 8px; }

.food-macros .m-cal { color: var(--red); opacity: 0.8; }

.food-macros .m-pro { color: var(--blue); opacity: 0.8; }

.food-macros .m-fib { color: var(--accent); opacity: 0.8; }

.btn-del { width: 30px; height: 30px; background: none; border: 1px solid var(--border); border-radius: 50%; color: var(--text3); font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: 0.15s; }

.btn-del:active { background: rgba(255, 92, 92, 0.15); border-color: var(--red); color: var(--red); }

.empty-state { padding: 40px 20px; text-align: center; color: var(--text3); font-size: 14px; }

.empty-icon { font-size: 32px; margin-bottom: 10px; opacity: 0.4; display: block; }

.cal-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }

.cal-nav-btn { width: 38px; height: 38px; background: var(--surface); border: 1px solid var(--border); border-radius: 50%; font-size: 18px; color: var(--text2); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.15s; }

.cal-nav-btn:active { background: var(--surface3); }

.cal-month-title { font-family: Syne, sans-serif; font-size: 18px; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }

.cal-grid-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; }

.cal-dow-row { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; margin-bottom: 6px; }

.cal-dow { text-align: center; font-size: 11px; font-weight: 600; color: var(--text3); letter-spacing: 0.05em; padding: 4px 0px; }

.cal-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }

.cal-cell { aspect-ratio: 1 / 1; border-radius: 10px; border: 1px solid transparent; padding: 5px; cursor: pointer; transition: 0.15s; display: flex; flex-direction: column; align-items: center; overflow: hidden; position: relative; }

.cal-cell:not(.empty):hover { border-color: var(--border2); background: var(--surface2); }

.cal-cell:not(.empty):active { background: var(--surface3); }

.cal-cell.today { border-color: var(--accent); background: var(--accent-dim); }

.cal-cell.has-data { background: var(--surface2); border-color: var(--border); }

.cal-cell.today.has-data { border-color: var(--accent); }

.cal-day-num { font-family: Syne, sans-serif; font-size: 12px; font-weight: 700; color: var(--text2); line-height: 1; }

.cal-cell.today .cal-day-num { color: var(--accent); }

.cal-cals-label { font-size: 9px; font-weight: 600; color: var(--red); margin-top: 2px; opacity: 0.85; line-height: 1; }

.cal-dots { display: flex; gap: 2px; margin-top: 3px; justify-content: center; }

.cal-dot { width: 4px; height: 4px; border-radius: 50%; }

.dot-c { background: var(--red); }

.dot-p { background: var(--blue); }

.dot-f { background: var(--accent); }

.cal-legend { display: flex; gap: 14px; justify-content: center; margin-top: 12px; }

.legend-item { display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--text2); }

.legend-dot { width: 6px; height: 6px; border-radius: 50%; }

.toast { position: fixed; bottom: calc(var(--safe-bottom) + 20px); left: 50%; transform: translateX(-50%) translateY(20px); background: var(--accent); color: rgb(15, 15, 15); font-family: Syne, sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.03em; padding: 10px 20px; border-radius: 50px; opacity: 0; transition: 0.25s cubic-bezier(0.34, 1.56, 0.64, 1); pointer-events: none; z-index: 999; white-space: nowrap; }

.toast.show { opacity: 1; transform: translateX(-50%) translateY(0px); }

.item-actions { display: flex; gap: 6px; flex-shrink: 0; }

.btn-edit { width: 30px; height: 30px; background: none; border: 1px solid var(--border); border-radius: 50%; color: var(--text3); font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: 0.15s; }

.btn-edit:active { background: rgba(200, 240, 96, 0.15); border-color: var(--accent); color: var(--accent); }

.food-item.editing { flex-direction: column; align-items: stretch; gap: 8px; padding: 12px 16px; }

.edit-name-input { width: 100%; background: var(--surface2); border: 1px solid var(--accent); border-radius: var(--radius-sm); padding: 8px 12px; font-family: "DM Sans", sans-serif; font-size: 15px; font-weight: 500; color: var(--text); outline: none; appearance: none; }

.edit-macros-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }

.edit-macro-input { background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 7px 8px; font-family: "DM Sans", sans-serif; font-size: 14px; color: var(--text); outline: none; text-align: center; width: 100%; appearance: none; }

.edit-macro-input:focus { border-color: var(--accent); }

.edit-btns { display: flex; gap: 6px; justify-content: flex-end; }

.btn-save-edit { padding: 7px 18px; background: var(--accent); color: rgb(15, 15, 15); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: var(--radius-sm); font-family: Syne, sans-serif; font-size: 13px; font-weight: 700; cursor: pointer; transition: 0.15s; }

.btn-cancel-edit { padding: 7px 12px; background: none; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--text2); font-family: "DM Sans", sans-serif; font-size: 13px; cursor: pointer; transition: 0.15s; }

.add-day-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; margin-top: 12px; }

.add-day-card h2 { font-family: Syne, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text2); margin-bottom: 12px; }

.burn-deficit-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 16px; }

.total-tile.burn { border-color: rgba(255, 170, 92, 0.25); }

.burn-input { background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; width: 100%; font-family: Syne, sans-serif; font-size: 26px; font-weight: 800; letter-spacing: -0.03em; line-height: 1; color: var(--orange); text-align: center; padding: 0px; appearance: none; }

.burn-input::placeholder { color: var(--text3); font-size: 18px; font-weight: 400; font-family: "DM Sans", sans-serif; }

.burn-input:focus { outline: none; }

.total-tile.deficit-none { border-color: var(--border); }

.total-tile.deficit-none .tile-val { color: var(--text3); }

.total-tile.deficit-pos { border-color: rgba(200, 240, 96, 0.25); }

.total-tile.deficit-pos .tile-val { color: var(--accent); }

.total-tile.deficit-neg { border-color: rgba(255, 90, 90, 0.25); }

.total-tile.deficit-neg .tile-val { color: var(--red); }

.week-summaries { margin-top: 14px; display: flex; flex-direction: column; gap: 6px; }

.week-summaries-title { font-family: Syne, sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text3); margin-bottom: 2px; }

.week-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); }

.week-label { font-size: 13px; color: var(--text2); }

.week-deficit-val { font-family: Syne, sans-serif; font-size: 14px; font-weight: 700; letter-spacing: -0.01em; }

.week-deficit-val.deficit { color: var(--accent); }

.week-deficit-val.surplus { color: var(--red); }

.week-deficit-val.none { color: var(--text3); }

.tab-content::-webkit-scrollbar { width: 0px; }
