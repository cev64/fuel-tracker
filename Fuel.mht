</head>
<body>
<div id="app">
  <div class="app-header">
    <div class="wordmark">fuel<span>.</span></div>
  </div>

  <div class="tab-bar">
    <button class="tab-btn active">Log</button>
    <button class="tab-btn">Today</button>
    <button class="tab-btn">Calendar</button>
  </div>

  <!-- LOG TAB -->
  <div class="tab-content active" id="tab-log">
    <div class="form-card">
      <h2>Add food</h2>
      <div class="input-group">
        <label>Food item</label>
        <input type="text" id="f-name" placeholder="e.g. Chicken breast" autocomplete="off" autocorrect="off">
      </div>
      <div class="macros-grid">
        <div class="macro-input">
          <span class="macro-label">Cals</span>
          <input type="number" id="f-cal" placeholder="0" min="0" inputmode="decimal">
        </div>
        <div class="macro-input">
          <span class="macro-label">Protein g</span>
          <input type="number" id="f-pro" placeholder="0" min="0" inputmode="decimal">
        </div>
        <div class="macro-input">
          <span class="macro-label">Fiber g</span>
          <input type="number" id="f-fib" placeholder="0" min="0" inputmode="decimal">
        </div>
      </div>
      <button class="btn-submit">Add to log</button>
    </div>
  </div>

  <!-- TODAY TAB -->
  <div class="tab-content" id="tab-today">
    <div class="day-nav">
      <button class="day-nav-btn">‹</button>
      <div class="day-label-wrap">
        <div class="day-label-main" id="day-main">Today</div>
        <div class="day-label-sub" id="day-sub">August 10, 2026</div>
      </div>
      <button class="day-nav-btn">›</button>
    </div>

    <div class="totals-strip">
      <div class="total-tile cals">
        <div class="tile-val" id="t-cal">0</div>
        <div class="tile-label">kcal</div>
      </div>
      <div class="total-tile prot">
        <div class="tile-val" id="t-pro">0</div>
        <div class="tile-label">protein</div>
      </div>
      <div class="total-tile fib">
        <div class="tile-val" id="t-fib">0</div>
        <div class="tile-label">fiber</div>
      </div>
    </div>

    <div class="burn-deficit-row">
      <div class="total-tile burn">
        <input class="burn-input" type="number" id="t-burn" placeholder="—" min="0" inputmode="decimal">
        <div class="tile-label">burned kcal</div>
      </div>
      <div class="total-tile deficit-none" id="deficit-tile">
        <div class="tile-val" id="deficit-val">—</div>
        <div class="tile-label">deficit</div>
      </div>
    </div>

    <div class="food-log-card">
      <div class="food-log-title">Items logged</div>
      <div id="food-list"><div class="empty-state"><span class="empty-icon">🍽</span>Nothing logged yet</div></div>
    </div>

    <div class="add-day-card">
      <h2>Add item</h2>
      <div class="input-group" style="margin-bottom:10px;">
        <input type="text" id="d-name" placeholder="Food item" autocomplete="off" autocorrect="off">
      </div>
      <div class="macros-grid" style="margin-bottom:12px;">
        <div class="macro-input">
          <span class="macro-label">Cals</span>
          <input type="number" id="d-cal" placeholder="0" min="0" inputmode="decimal">
        </div>
        <div class="macro-input">
          <span class="macro-label">Protein g</span>
          <input type="number" id="d-pro" placeholder="0" min="0" inputmode="decimal">
        </div>
        <div class="macro-input">
          <span class="macro-label">Fiber g</span>
          <input type="number" id="d-fib" placeholder="0" min="0" inputmode="decimal">
        </div>
      </div>
      <button class="btn-submit">Add to this day</button>
    </div>
  </div>

  <!-- CALENDAR TAB -->
  <div class="tab-content" id="tab-calendar">
    <div class="cal-nav">
      <button class="cal-nav-btn">‹</button>
      <div class="cal-month-title" id="cal-month-title">August 2026</div>
      <button class="cal-nav-btn">›</button>
    </div>
    <div class="cal-grid-wrap">
      <div class="cal-dow-row">
        <div class="cal-dow">Su</div><div class="cal-dow">Mo</div><div class="cal-dow">Tu</div>
        <div class="cal-dow">We</div><div class="cal-dow">Th</div><div class="cal-dow">Fr</div>
        <div class="cal-dow">Sa</div>
      </div>
      <div class="cal-days" id="cal-days"><div class="cal-cell empty"></div><div class="cal-cell empty"></div><div class="cal-cell empty"></div><div class="cal-cell empty"></div><div class="cal-cell empty"></div><div class="cal-cell empty"></div><div class="cal-cell">
        <div class="cal-day-num">1</div>
        
        
      </div><div class="cal-cell">
        <div class="cal-day-num">2</div>
        
        
      </div><div class="cal-cell">
