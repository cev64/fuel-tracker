    </div>
    <div class="cal-legend">
      <div class="legend-item"><div class="legend-dot dot-c"></div> Calories</div>
      <div class="legend-item"><div class="legend-dot dot-p"></div> Protein</div>
      <div class="legend-item"><div class="legend-dot dot-f"></div> Fiber</div>
    </div>
    <div class="week-summaries" id="week-summaries"><div class="week-summaries-title">Weekly Deficit</div><div class="week-row"><span class="week-label">Aug 1</span><span class="week-deficit-val none">—</span></div><div class="week-row"><span class="week-label">Aug 2–8</span><span class="week-deficit-val none">—</span></div><div class="week-row"><span class="week-label">Aug 9–15</span><span class="week-deficit-val none">—</span></div><div class="week-row"><span class="week-label">Aug 16–22</span><span class="week-deficit-val none">—</span></div><div class="week-row"><span class="week-label">Aug 23–29</span><span class="week-deficit-val none">—</span></div><div class="week-row"><span class="week-label">Aug 30–31</span><span class="week-deficit-val none">—</span></div></div>
  </div>
</div>

<div class="toast" id="toast"></div>




